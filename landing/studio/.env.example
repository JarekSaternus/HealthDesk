# Blog Studio local environment — copy to `.env` and fill in.
# `.env` is gitignored; never commit real secrets.

# FTP password for healthdesk@healthdesk.site (cyber-folks).
# Used by autopilot / manual deploy via `exec('node deploy.js')`.
# Required — deploy.js hard-fails without it.
# IMPORTANT: wrap in quotes if the password contains `#` (comment marker in dotenv).
FTP_PASS="replace-me"

# Optional API key overrides (studio.json also holds these):
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
